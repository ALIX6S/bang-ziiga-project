# Configuration Serveur
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/bang_ziiga
# OU pour MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bang_ziiga

# JWT Authentication
JWT_SECRET=votre_cle_secrete_super_longue_et_complexe_ici
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Upload d'images (Cloudinary - optionnel)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Service (optionnel pour MVP)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Logs
LOG_LEVEL=info